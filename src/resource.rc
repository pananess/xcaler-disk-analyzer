#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APP_ICON ICON "app.ico"
IDB_APP_LOGO BITMAP "logo.bmp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName",      "NovoXcale (novoxcale.com)"
            VALUE "FileDescription",  "Xcaler Disk Analyzer - Analizador nativo de espacio en disco"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "xcaler-disk-analyzer"
            VALUE "LegalCopyright",   "Copyright (C) 2026 NovoXcale (https://novoxcale.com)"
            VALUE "OriginalFilename", "xcaler-disk-analyzer.exe"
            VALUE "ProductName",      "Xcaler Disk Analyzer"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
